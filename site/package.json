{
  "name": "spotuify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "npm run generate:changelog && node scripts/generate-cli-reference.mjs",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "validate": "node scripts/validate-docs.mjs",
    "postbuild": "node scripts/generate-llms-txt.mjs",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && npm run validate && astro build && node scripts/generate-llms-txt.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.6",
    "astro": "7.2.1",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
